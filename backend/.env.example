# TruthLens Backend Environment Configuration

# Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
DEBUG=true

# Security & CORS
ALLOWED_ORIGINS=*
SECRET_KEY=dev_secret_key_change_in_production_truthlens

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# ML Model Paths
ML_MODEL_PATH=backend/app/ml/saved_models/model.joblib
ML_VECTORIZER_PATH=backend/app/ml/saved_models/vectorizer.joblib
ML_METRICS_PATH=backend/app/ml/saved_models/metrics.json

# Dataset Configuration (User provided)
DATASET_PATH=backend/data/news_dataset.csv

# External APIs (Optional - for advanced fact checking in Phase 2)
GOOGLE_FACT_CHECK_API_KEY=
NEWS_API_KEY=
